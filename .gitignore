# The staged site, which the pages workflow builds and uploads rather than
# committing. The same thing locally, to look at before pushing:
#   git archive HEAD | tar -x -C _site && cp build/*.js _site/build/
#   node scripts/gallery-history.mjs --out _site/test/render/runs
/_site/
/gallery/

# Per-version render gallery snapshots. The site keeps the last ten runs
# instead, recorded by the pages workflow, so committing about 20MB of pngs per
# release against a 19MB repository buys nothing. Locally: npm run gallery.
releases/*/gallery/
